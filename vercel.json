{
  "routes": [
    {
      "src": "/api/index",
      "dest": "api/index.py"
    },
    {
      "src": "/api/config-status",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  }
}